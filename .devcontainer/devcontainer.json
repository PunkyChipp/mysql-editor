{
  "name": "Study Desk \u2014 private browser workspace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "forwardPorts": [
    8787
  ],
  "portsAttributes": {
    "8787": {
      "label": "Study Desk",
      "onAutoForward": "openPreview",
      "protocol": "http"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["BOOTING.md"]
    },
    "vscode": {
      "settings": {
        "chat.disableAIFeatures": true
      }
    }
  },
  "postAttachCommand": "python3 launch.py --no-browser"
}
